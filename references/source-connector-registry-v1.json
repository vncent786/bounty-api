{
  "schema_version": "bounty-source-registry/1",
  "credential_policy": {
    "rule": "Sources name a credential profile. Secret values stay in the local environment, Railway variables, Windows Credential Manager or an authenticated browser profile. Values never enter this file, evidence, logs or reports.",
    "local_precedence": [
      "explicit process environment",
      "canonical repository environment",
      "Windows Credential Manager",
      "registered authenticated browser or cookie path"
    ],
    "cloud_precedence": [
      "Railway environment variables",
      "mounted secret files"
    ]
  },
  "credential_profiles": {
    "none": {
      "requirements": []
    },
    "x_owned_session": {
      "requirements": [
        {"name": "auth_token", "kind": "env", "locator": "BOUNTY_X_AUTH_TOKEN", "required": true, "sensitive": true},
        {"name": "state_db", "kind": "path_env", "locator": "BOUNTY_X_SCWEET_DB", "required": false, "sensitive": false}
      ]
    },
    "tiktok_owned_session": {
      "requirements": [
        {"name": "browser_profile", "kind": "path_env", "locator": "BOUNTY_TIKTOK_PROFILE_PATH", "required": true, "sensitive": false},
        {"name": "proxy_extension", "kind": "path_env", "locator": "BOUNTY_TIKTOK_EXTENSION_PATH", "required": false, "sensitive": false}
      ]
    },
    "instagram_owned_session": {
      "requirements": [
        {"name": "cookie_file", "kind": "path_env", "locator": "BOUNTY_IG_COOKIE_PATH", "required": true, "sensitive": false}
      ]
