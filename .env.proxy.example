# Bounty Social API proxy settings
# Copy to .env locally or set as Railway environment variables.
# NEVER commit real credentials.

# Example formats:
# BOUNTY_PROXY_SERVER=http://geo.iproyal.com:12321
# BOUNTY_PROXY_SERVER=http://proxy.geonode.io:9000
BOUNTY_PROXY_SERVER=

# Provider username, often includes geo/session params depending on provider.
# Example only, exact format comes from the proxy dashboard.
BOUNTY_PROXY_USERNAME=

# Provider password/API token.
BOUNTY_PROXY_PASSWORD=
